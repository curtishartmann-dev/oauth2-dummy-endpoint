# Server
PORT=3000

# Comma-separated list of clients in the form id:secret:scope1 scope2
# Example below: demo-client / demo-secret with scopes "read write"
OAUTH_CLIENTS=demo-client:demo-secret:read write,another-client:another-secret:read

# JWT signing secret (HS256). In production use a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# JWT issuer (used as `iss` claim). Override on render.com to your service URL.
JWT_ISSUER=https://oauth2-dummy.onrender.com

# Access token lifetime (seconds)
TOKEN_TTL=3600
